{
  "name": "campus-bites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev": "node scripts/dev.js",
    "dev:student": "vite student-app --config student-app/vite.config.js --port 5173 --host",
    "dev:admin": "vite admin-app --config admin-app/vite.config.js --port 5174 --host",
    "build": "npm run build:all",
    "build:all": "vite build student-app --config student-app/vite.config.js --outDir ../dist --emptyOutDir && vite build admin-app --config admin-app/vite.config.js --base /admin/ --outDir ../dist/admin && node scripts/sync_dist_assets.js",
    "build:student": "vite build student-app --config student-app/vite.config.js --outDir ../dist --emptyOutDir",
    "build:admin": "vite build admin-app --config admin-app/vite.config.js --base /admin/ --outDir ../dist/admin"
  },
  "dependencies": {
    "@neon/config": "^1.4.0",
    "@neon/env": "^1.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "nodemailer": "^10.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
